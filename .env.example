# ==============================================================================
# Enterprise APMS - Environment Configuration Template
# ==============================================================================
# In production:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in production secrets and connection strings.
# 3. DO NOT commit the resulting .env file to version control.
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8008
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=*

# Telemetry Buffer & Historian Storage
RING_BUFFER_CAPACITY=500
STALE_SENSOR_THRESHOLD_SEC=30.0

# Database / Historian:
# For local/staging: ./data/apms_historian.db
# For production (PostgreSQL / TimescaleDB):
# HISTORIAN_DB_PATH=postgresql+psycopg2://user:password@timescaledb-host:5432/apms
HISTORIAN_DB_PATH=./data/apms_historian.db
HISTORIAN_RETAIN_DAYS=90

# Security (JWT & API Keys)
# Set to 'false' in production to enforce strict JWT/API key authentication
APMS_AUTH_DISABLED=false
APMS_JWT_SECRET=generate_a_random_32_character_secret_key_here
APMS_JWT_EXPIRY=86400

# Streaming Ingestion - MQTT (Optional)
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Streaming Ingestion - Apache Kafka (Optional)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=apms-telemetry
KAFKA_GROUP_ID=apms-consumer-group

# Similarity-Based Modeling (SBM) Engine
SBM_MIN_TRAIN_SAMPLES=30
SBM_REFERENCE_SAMPLES=100
SBM_CUSUM_THRESHOLD=5.0

# Observability
ENABLE_METRICS=true

# ==============================================================================
# Dynamic Threshold Provider & Alert Limits (4-Tier Hierarchy)
# Tier 1: Upstream Fleet API (/api/ai/query)
# Tier 2: Environment variables / .env (below)
# Tier 3: Machine Specs & ISO 20816 / ISO 10816 standards
# Tier 4: Digital Twin baseline defaults
# ==============================================================================
# Upstream API Connection:
AI_SERVICE_BASE_URL=http://168.144.37.186:4000
AI_SERVICE_API_KEY=
THRESHOLD_CACHE_TTL_SEC=300.0

# Optional: load MQTT broker + topic list from POST /ai/query (include mqtt, topics)
# Password is never returned by the API — set MQTT_PASSWORD locally when hasPassword=true
# FLEET_MQTT_FROM_QUERY=true
# FLEET_MQTT_MACHINE_ID=g-sensor-01
# MQTT_PASSWORD=

# Optional Tier 2 Environment Threshold Overrides:
# Machine-specific vibration alert range: min,max in mm/s (e.g. for G-Sensor-01: 0.0,0.1)
# VIBRATION_ALERT_BAND_G_SENSOR_01=0.0,0.1
# VIBRATION_ALERT_BAND_GBZ_RX_1=0.0,0.1
# Default vibration alert range if not in API or machine specs:
# DEFAULT_VIBRATION_ALERT_BAND=0.0,4.5

# Bulk JSON threshold dictionary override:
# MACHINE_THRESHOLDS_JSON={"g-sensor-01": {"vibration_band_min": 0.0, "vibration_band_max": 0.1}}

# Parameter specific overrides (warning/danger):
# DEFAULT_VIBRATION_WARNING_MM_S=4.5
# DEFAULT_VIBRATION_DANGER_MM_S=7.1
# DEFAULT_TEMP_WARNING_C=75.0
# DEFAULT_TEMP_DANGER_C=90.0

# ==============================================================================
# Tier 3: Internet & Machine Spec Search Agent Configuration
# Automatically retrieves OEM tolerances based on make, model, year of manufacture
# and applies age-degradation calibration (commissioning, mature, vintage wear factor).
# ==============================================================================
INTERNET_SPEC_SEARCH_ENABLED=true
INTERNET_SPEC_SEARCH_URL=
INTERNET_SPEC_SEARCH_API_KEY=
INTERNET_SPEC_TIMEOUT_S=4.0


